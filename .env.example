# Personal Profile — server environment (D1). DUMMY VALUES ONLY: never commit
# real secrets. Copy to .env.local for `pnpm dev`; Vercel holds the real values.
#
# One deployment serves both 1health environments. The environment of a session
# is the one whose key decrypts its launch payload; 1health origins are fixed in
# lib/shared/environments.ts and never come from an env var.

# LPL decryption key + exchange-signature secret, per environment (required).
ONEHEALTH_SECRET_KEY_DEMO=dummy-demo-secret
ONEHEALTH_SECRET_KEY_PROD=dummy-prod-secret

# External Application id (`required.apiKey.name`), per environment (required).
APP_ID_DEMO=dummy-app-demo
APP_ID_PROD=dummy-app-prod

# iron-session sealing key, at least 32 characters (required).
SESSION_SECRET=dummy-session-secret-0123456789abcdef
# Previous sealing key, accepted for unsealing only during a rotation (optional).
SESSION_SECRET_PREVIOUS=

# Google Places address suggestions (optional; the key is required when enabled).
PLACES_ENABLED=0
GOOGLE_PLACES_KEY=

# Kill switches: "1" turns them on; any other value is off.
PP_DISABLED=0
# Parsed only; enforced from the Story 1.3 rework (R2).
ACCOUNT_DISABLED=0

# Copy to .env.local and fill in. Read only by lib/server/env.ts (validated at boot).

# External Application credentials, one pair per 1health environment.
# The launch detects the environment by the key that decrypts the payload (prod, then demo, then dev).
# Every configured secret key must differ from the others.
ONEHEALTH_SECRET_KEY_DEMO=
ONEHEALTH_SECRET_KEY_PROD=
APP_ID_DEMO=
APP_ID_PROD=
# Optional: the dev environment (https://dev.1hdev.io). Set both to enable dev, or neither;
# exactly one set fails the boot. Without them dev launches are refused and /auth offers no Dev option.
# ONEHEALTH_SECRET_KEY_DEV=
# APP_ID_DEV=

# Seals the __Host-pp_s session cookie. At least 32 characters.
SESSION_SECRET=
# Optional: the previous SESSION_SECRET, accepted for unseal only during a rotation.
SESSION_SECRET_PREVIOUS=

# Kill switches: "1" turns them on, anything else is off.
# PP_DISABLED=1: every page (/, /auth, /account) shows the 503 disabled screen and launch, the proxy,
# /api/pp/**, /api/places/**, refresh and ping answer 503 SERVICE_DISABLED. Logout keeps working.
PP_DISABLED=
# ACCOUNT_DISABLED=1 does the same for the Profile module only: /account, /handoff/**,
# /api/pp/{mfa,org-logo,practice-support}/** and the profile-tagged proxy entries.
ACCOUNT_DISABLED=

# Test only: "1" serves the Playwright fixture pages under /test-fixtures/**. Never set it in a deployment.
PP_E2E_FIXTURES=
# Test only: "1" installs the server-side e2e upstream mock (test/e2e-upstream-mock.ts): the launch
# exchange, myself and the logout revoke are answered locally, every other 1health call fails. Never set it in a deployment.
PP_E2E_MOCK=

# Address suggestions (later epic). PLACES_ENABLED=1 requires GOOGLE_PLACES_KEY.
PLACES_ENABLED=
GOOGLE_PLACES_KEY=

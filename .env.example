# Copy to .env.local and fill in. Read only by lib/server/env.ts (validated at boot).

# External Application credentials, one pair per 1health environment.
# The launch detects Demo or Prod by the key that decrypts the payload.
ONEHEALTH_SECRET_KEY_DEMO=
ONEHEALTH_SECRET_KEY_PROD=
APP_ID_DEMO=
APP_ID_PROD=

# Seals the __Host-pp_s session cookie. At least 32 characters.
SESSION_SECRET=
# Optional: the previous SESSION_SECRET, accepted for unseal only during a rotation.
SESSION_SECRET_PREVIOUS=

# Kill switches: "1" turns them on, anything else is off.
# PP_DISABLED=1 makes launch, the proxy and refresh answer 503 SERVICE_DISABLED.
PP_DISABLED=
# ACCOUNT_DISABLED=1 does the same for Profile-module (/account) entries only.
ACCOUNT_DISABLED=

# Test only: "1" serves the Playwright fixture pages under /test-fixtures/**. Never set it in a deployment.
PP_E2E_FIXTURES=

# Address suggestions (later epic). PLACES_ENABLED=1 requires GOOGLE_PLACES_KEY.
PLACES_ENABLED=
GOOGLE_PLACES_KEY=
